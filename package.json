{
  "name": "tiendatek-gs1",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:build": "npm run build && electron-builder --win",
    "electron:portable": "npm run build && electron-builder --win portable",
    "electron:installer": "npm run build && electron-builder --win nsis",
    "electron:dir": "npm run build && electron-builder --win dir",
    "electron:rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jszip": "^3.4.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "productName": "Tiendatek GS1 - Generador EAN-13",
  "main": "electron-main.cjs",
  "build": {
    "appId": "mx.tiendatek.gs1",
    "productName": "Tiendatek GS1 - Generador EAN-13",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Tiendatek-GS1-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Tiendatek-GS1-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Tiendatek-GS1-${version}-Portable.${ext}"
    },
    "npmRebuild": false
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "description": "Generador de códigos EAN-13 GS1 México para TiendaTek",
  "author": "TiendaTek"
}